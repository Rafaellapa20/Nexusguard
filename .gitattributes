# Normaliza finais de linha: o repositório guarda LF, o Windows recebe CRLF.
* text=auto

*.cs      text diff=csharp
*.xaml    text
*.csproj  text
*.sln     text eol=crlf
*.md      text
*.yml     text
*.json    text

# Ficheiros que o Inno Setup e o PowerShell leem melhor com CRLF.
*.iss     text eol=crlf
*.ps1     text eol=crlf

# Binários: nunca converter.
*.ico     binary
*.png     binary
*.pdf     binary
*.exe     binary
