<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Texto ===================== -->
    <Style TargetType="TextBlock" x:Key="T.Base">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Base}" />

    <Style TargetType="TextBlock" x:Key="T.H1" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
        <Setter Property="FontSize" Value="25" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="TextBlock" x:Key="T.H2" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="TextBlock" x:Key="T.Metric" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="TextBlock" x:Key="T.Dim" BasedOn="{StaticResource T.Base}">
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
    </Style>

    <Style TargetType="TextBlock" x:Key="T.Muted" BasedOn="{StaticResource T.Base}">
        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="TextBlock" x:Key="T.Label" BasedOn="{StaticResource T.Base}">
        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="TextBlock" x:Key="T.Mono" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ===================== Cartao ===================== -->
    <Style TargetType="Border" x:Key="Card">
        <Setter Property="Background" Value="{StaticResource B.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource R.Card}" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="Border" x:Key="Card.Flat" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource B.BgRaised}" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- ===================== Icone ===================== -->
    <Style TargetType="Path" x:Key="Icon">
        <Setter Property="Stroke" Value="{StaticResource B.TextDim}" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
    </Style>

    <Style TargetType="Path" x:Key="Icon.Small" BasedOn="{StaticResource Icon}">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="StrokeThickness" Value="1.8" />
    </Style>

    <!-- ===================== Botoes ===================== -->
    <Style TargetType="Button" x:Key="Btn.Base">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource R.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="Btn.Primary" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{StaticResource B.AccentGradH}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#0B0E14" />
    </Style>

    <Style TargetType="Button" x:Key="Btn.Secondary" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{StaticResource B.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="Button" x:Key="Btn.Ghost" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style TargetType="Button" x:Key="Btn.Danger" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{StaticResource B.DangerSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Danger}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource B.Danger}" />
    </Style>

    <Style TargetType="Button" x:Key="Btn.Chrome">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.SurfaceHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="Btn.Close" BasedOn="{StaticResource Btn.Chrome}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Navegacao ===================== -->
    <Style TargetType="ListBox" x:Key="Nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,2" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid>
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Padding="11,9" />
                                    <Border x:Name="Bar" Width="3" Height="18" HorizontalAlignment="Left"
                                            CornerRadius="2" Background="{StaticResource B.AccentGradH}"
                                            Opacity="0" Margin="-1,0,0,0" />
                                    <ContentPresenter Margin="11,9" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.SurfaceHover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.SurfaceAlt}" />
                                        <Setter TargetName="Bar" Property="Opacity" Value="1" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== CheckBox ===================== -->
    <Style TargetType="CheckBox" x:Key="Chk">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                                Background="{StaticResource B.BgRaised}"
                                BorderBrush="{StaticResource B.BorderStrong}" BorderThickness="1.2"
                                VerticalAlignment="Center">
                            <Path x:Name="Tick" Data="M4 8.5 7 11.5 12.5 5" Stretch="Uniform" Margin="3"
                                  Stroke="#0B0E14" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Opacity="0" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource B.AccentGradH}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="Tick" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Interruptor ===================== -->
    <Style TargetType="CheckBox" x:Key="Switch">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="40" Height="22" CornerRadius="11"
                            Background="{StaticResource B.SurfaceAlt}"
                            BorderBrush="{StaticResource B.BorderStrong}" BorderThickness="1">
                        <Border x:Name="Knob" Width="16" Height="16" CornerRadius="8"
                                Background="{StaticResource B.TextMuted}"
                                HorizontalAlignment="Left" Margin="3,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource B.AccentGradH}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            <Setter TargetName="Knob" Property="Background" Value="#0B0E14" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== RadioButton (segmentos) ===================== -->
    <Style TargetType="RadioButton" x:Key="Segment">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="13,7"
                            BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.AccentSoft}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Barra de progresso ===================== -->
    <Style TargetType="ProgressBar" x:Key="Pb">
        <Setter Property="Height" Value="6" />
        <Setter Property="Background" Value="{StaticResource B.SurfaceAlt}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource B.AccentGradH}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="3" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Caixa de texto ===================== -->
    <Style TargetType="TextBox" x:Key="Tb">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource B.Accent2}" />
        <Setter Property="SelectionBrush" Value="{StaticResource B.Accent}" />
        <Setter Property="Background" Value="{StaticResource B.BgRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="11,8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource R.Control}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ComboBox ===================== -->
    <ControlTemplate x:Key="Cb.Toggle" TargetType="ToggleButton">
        <Border x:Name="Bd" Background="{StaticResource B.BgRaised}"
                BorderBrush="{StaticResource B.BorderStrong}" BorderThickness="1"
                CornerRadius="{StaticResource R.Control}" Padding="11,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Host" VerticalAlignment="Center" />
                <Path Grid.Column="1" Data="M1 1 5 5 9 1" Stretch="None" Margin="10,0,2,0"
                      VerticalAlignment="Center" Stroke="{StaticResource B.TextDim}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBoxItem" x:Key="CbItem">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="11,8" CornerRadius="6" Margin="4,1">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox" x:Key="Cb">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource CbItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="PART_ToggleButton" Focusable="False" ClickMode="Press"
                                      Template="{StaticResource Cb.Toggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center" />
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.BorderStrong}"
                                    BorderThickness="1" CornerRadius="9" Margin="0,4,0,0" Padding="0,4"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
                                </Border.Effect>
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Barras de deslocamento ===================== -->
    <Style TargetType="Thumb" x:Key="Sb.Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource B.BorderStrong}" CornerRadius="4" Margin="3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="11" />
        <Setter Property="MinWidth" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Sb.Thumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="11" />
                            <Setter Property="MinHeight" Value="11" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Separador ===================== -->
    <Style TargetType="Border" x:Key="Divider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource B.Border}" />
        <Setter Property="Margin" Value="0,12" />
    </Style>

    <!-- ===================== Etiqueta (pill) ===================== -->
    <Style TargetType="Border" x:Key="Pill">
        <Setter Property="CornerRadius" Value="{StaticResource R.Pill}" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Background" Value="{StaticResource B.SurfaceAlt}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===================== Linha de lista ===================== -->
    <Style TargetType="Border" x:Key="Row">
        <Setter Property="Background" Value="{StaticResource B.BgRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="Margin" Value="0,0,0,7" />
    </Style>

    <!-- ===================== Consola de saída ===================== -->
    <Style TargetType="TextBox" x:Key="Console" BasedOn="{StaticResource Tb}">
        <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="Background" Value="#080B11" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- ===================== Tooltip ===================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource B.SurfaceAlt}" BorderBrush="{StaticResource B.BorderStrong}"
                            BorderThickness="1" CornerRadius="7" Padding="10,7" MaxWidth="420">
                        <ContentPresenter TextElement.Foreground="{StaticResource B.Text}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ===================== Cabecalho de grupo da barra lateral ===================== -->
    <Style TargetType="TextBlock" x:Key="T.Group" BasedOn="{StaticResource T.Base}">
        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="12,14,12,4" />
    </Style>

    <!-- ===================== Chip de filtro ===================== -->
    <Style TargetType="ToggleButton" x:Key="Chip">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,7,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" CornerRadius="999" Padding="12,5"
                            Background="{StaticResource B.BgRaised}"
                            BorderBrush="{StaticResource B.Border}" BorderThickness="1">
                        <ContentPresenter VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.AccentSoft}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Janela modal ===================== -->
    <Style TargetType="Window" x:Key="Modal">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style TargetType="Border" x:Key="ModalShell">
        <Setter Property="Background" Value="{StaticResource B.Bg}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Margin" Value="18" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.55" Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Barra de passos do onboarding ===================== -->
    <Style TargetType="Border" x:Key="StepSeg">
        <Setter Property="Height" Value="3" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{StaticResource B.Border}" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <!-- ===================== Item de navegacao ===================== -->
    <ControlTemplate x:Key="NavItemTemplate" TargetType="ToggleButton">
        <Grid Background="Transparent">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="12,8" />
            <Border x:Name="Bar" Width="2" Height="16" HorizontalAlignment="Left" CornerRadius="1"
                    Background="{StaticResource B.Accent}" Opacity="0" />
            <ContentPresenter Margin="12,8" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.SurfaceAlt}" />
                <Setter TargetName="Bar" Property="Opacity" Value="1" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ===================== Cartao de estatistica clicavel ===================== -->
    <Style TargetType="Button" x:Key="StatCard">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource B.Surface}"
                            BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                            CornerRadius="{StaticResource R.Card}" Padding="16">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.SurfaceAlt}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
