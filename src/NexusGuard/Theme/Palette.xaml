    <Geometry x:Key="I.Apps">M12 3.5v11 M8.1 10.9 12 14.8l3.9-3.9 M4.5 19.5h15</Geometry>
    <Geometry x:Key="I.Driver">M9.2 3.2v5.4 M14.8 3.2v5.4 M6.6 8.6h10.8v3.1a5.4 5.4 0 0 1-10.8 0z M12 17.1v3.7</Geometry>
    <Geometry x:Key="I.Backup">M3.2 8.1h17.6v7.8H3.2z M3.2 12h7 M17.4 12h.01 M13.8 12h.01 M12 4.4V1.8 M12 1.8 10 3.9 M12 1.8 14 3.9</Geometry>
    <Geometry x:Key="I.Log">M5.4 3.6h13.2v16.8H5.4z M8.4 8.1h7.2 M8.4 12h7.2 M8.4 15.9h4.5</Geometry>
    <Geometry x:Key="I.Refresh">M20 11.5a8 8 0 1 0-2.6 6.4 M20 5.5v6h-6</Geometry>
    <Geometry x:Key="I.Play">M8.5 5.5 18 12l-9.5 6.5z</Geometry>
    <Geometry x:Key="I.Stop">M7 7h10v10H7z</Geometry>
    <Geometry x:Key="I.Check">M4.5 12.5 9.5 17.5 19.5 6.5</Geometry>
    <Geometry x:Key="I.Alert">M12 4 21 19.5H3z M12 9.5v5 M12 17h.01</Geometry>
    <Geometry x:Key="I.Admin">M12 3.2l7.6 2.7v5.6c0 4.8-3.3 7.7-7.6 8.7-4.3-1-7.6-3.9-7.6-8.7V5.9z M12 9v3 M12 14.5h.01</Geometry>
    <Geometry x:Key="I.Folder">M3.5 6.5h5l2 2.5h10v9.5h-17z</Geometry>
