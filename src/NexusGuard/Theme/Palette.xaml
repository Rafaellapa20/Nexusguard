<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============ Cores ============ -->
    <Color x:Key="C.Bg">#0C0F16</Color>
    <Color x:Key="C.BgRaised">#11151E</Color>
    <Color x:Key="C.Surface">#161B26</Color>
    <Color x:Key="C.SurfaceAlt">#1C2230</Color>
    <Color x:Key="C.SurfaceHover">#222A3A</Color>
    <Color x:Key="C.Border">#262E3E</Color>
    <Color x:Key="C.BorderStrong">#354057</Color>

    <Color x:Key="C.Text">#E8ECF4</Color>
    <Color x:Key="C.TextDim">#98A2B8</Color>
    <Color x:Key="C.TextMuted">#6A7488</Color>

    <Color x:Key="C.Accent">#7C5CF6</Color>
    <Color x:Key="C.Accent2">#22D3EE</Color>
    <Color x:Key="C.AccentDeep">#5B3FD6</Color>
    <Color x:Key="C.Ok">#34D399</Color>
    <Color x:Key="C.Warn">#FBBF24</Color>
    <Color x:Key="C.Danger">#F87171</Color>

    <!-- ============ Pinceis ============ -->
    <SolidColorBrush x:Key="B.Bg" Color="{StaticResource C.Bg}" />
    <SolidColorBrush x:Key="B.BgRaised" Color="{StaticResource C.BgRaised}" />
    <SolidColorBrush x:Key="B.Surface" Color="{StaticResource C.Surface}" />
    <SolidColorBrush x:Key="B.SurfaceAlt" Color="{StaticResource C.SurfaceAlt}" />
    <SolidColorBrush x:Key="B.SurfaceHover" Color="{StaticResource C.SurfaceHover}" />
    <SolidColorBrush x:Key="B.Border" Color="{StaticResource C.Border}" />
    <SolidColorBrush x:Key="B.BorderStrong" Color="{StaticResource C.BorderStrong}" />

    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="B.TextDim" Color="{StaticResource C.TextDim}" />
    <SolidColorBrush x:Key="B.TextMuted" Color="{StaticResource C.TextMuted}" />

    <SolidColorBrush x:Key="B.Accent" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="B.Accent2" Color="{StaticResource C.Accent2}" />
    <SolidColorBrush x:Key="B.Ok" Color="{StaticResource C.Ok}" />
    <SolidColorBrush x:Key="B.Warn" Color="{StaticResource C.Warn}" />
    <SolidColorBrush x:Key="B.Danger" Color="{StaticResource C.Danger}" />

    <SolidColorBrush x:Key="B.AccentSoft" Color="{StaticResource C.Accent}" Opacity="0.16" />
    <SolidColorBrush x:Key="B.OkSoft" Color="{StaticResource C.Ok}" Opacity="0.14" />
    <SolidColorBrush x:Key="B.WarnSoft" Color="{StaticResource C.Warn}" Opacity="0.14" />
    <SolidColorBrush x:Key="B.DangerSoft" Color="{StaticResource C.Danger}" Opacity="0.14" />

    <LinearGradientBrush x:Key="B.AccentGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource C.Accent}" Offset="0" />
        <GradientStop Color="{StaticResource C.Accent2}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="B.AccentGradH" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource C.Accent}" Offset="0" />
        <GradientStop Color="{StaticResource C.Accent2}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="B.SidebarGrad" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#131826" Offset="0" />
        <GradientStop Color="#0D111A" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="B.HeroGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1B2234" Offset="0" />
        <GradientStop Color="#141A26" Offset="1" />
    </LinearGradientBrush>

    <!-- ============ Tipografia ============ -->
    <FontFamily x:Key="F.UI">Segoe UI Variable Text, Segoe UI, Inter, Arial</FontFamily>
    <FontFamily x:Key="F.Display">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="F.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <sys:Double x:Key="S.Radius">10</sys:Double>
    <CornerRadius x:Key="R.Card">12</CornerRadius>
    <CornerRadius x:Key="R.Control">8</CornerRadius>
    <CornerRadius x:Key="R.Pill">999</CornerRadius>

    <!-- ============ Ícones (traco, 24x24) ============ -->
    <Geometry x:Key="I.Dashboard">M3.2 13.2a8.8 8.8 0 0 1 17.6 0 M12 13.2 16.4 8.6 M12 20.8v-1.6 M3.2 13.2H4.8 M19.2 13.2h1.6</Geometry>
