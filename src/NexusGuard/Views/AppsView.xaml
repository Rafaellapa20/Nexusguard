<UserControl x:Class="NexusGuard.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource F.UI}"
             Foreground="{StaticResource B.Text}">

    <Grid Margin="22,8,22,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Cabeçalho ============ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Background="{StaticResource B.HeroGrad}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="ATUALIZAÇÕES DE APLICAÇÕES" Style="{StaticResource T.Label}" />
                    <TextBlock x:Name="CountText" Text="—" Style="{StaticResource T.Metric}" Margin="0,6,0,0" />
                    <TextBlock x:Name="SubText" Style="{StaticResource T.Muted}" Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="Procura atualizações através do winget, o gerenciador de pacotes da Microsoft." />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ScanButton" Content="Procurar atualizações" Style="{StaticResource Btn.Secondary}"
                            Click="OnScan" />
                    <Button x:Name="UpdateButton" Content="Atualizar selecionadas" Style="{StaticResource Btn.Primary}"
                            Margin="8,0,0,0" Click="OnUpdateSelected" />
                    <Button x:Name="CancelButton" Content="Parar" Style="{StaticResource Btn.Danger}"
                            Margin="8,0,0,0" Click="OnCancel" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Aviso de winget em falta ============ -->
        <Border x:Name="WingetWarning" Grid.Row="1" Style="{StaticResource Card.Flat}" Margin="0,12,0,0"
                Background="{StaticResource B.WarnSoft}" BorderBrush="{StaticResource B.Warn}"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Style="{StaticResource Icon.Small}" Data="{StaticResource I.Alert}"
                      Stroke="{StaticResource B.Warn}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0,12,0">
                    <TextBlock Text="O winget não está instalado" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource B.Warn}" />
                    <TextBlock Style="{StaticResource T.Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Sem o «Programa de Instalação de Aplicativos» da Microsoft Store não é possível atualizar aplicativos por aqui." />
                </StackPanel>
                <Button Grid.Column="2" Content="Instalar da Store" Style="{StaticResource Btn.Secondary}"
                        VerticalAlignment="Center" Click="OnInstallWinget" />
            </Grid>
        </Border>

        <ProgressBar x:Name="Progress" Grid.Row="2" Style="{StaticResource Pb}" Margin="0,10,0,0"
                     Visibility="Collapsed" IsIndeterminate="True" Height="4" />

        <!-- ============ Lista ============ -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <ItemsControl x:Name="AppList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Row}" Padding="16,13">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Style="{StaticResource Chk}" IsChecked="{Binding Selected}"
                                              VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Margin="14,0,16,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Id}" Style="{StaticResource T.Muted}"
                                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="190">
                                        <TextBlock Text="{Binding VersionText}" FontSize="12.5" TextAlignment="Right"
                                                   FontFamily="{StaticResource F.Mono}" />
                                        <TextBlock Text="{Binding Source}" Style="{StaticResource T.Muted}"
                                                   FontSize="11" TextAlignment="Right" Margin="0,3,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="18,0,0,0"
                                                MinWidth="160">
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource T.Muted}"
                                                   TextAlignment="Right" TextWrapping="Wrap" />
                                        <Button Content="Atualizar" Style="{StaticResource Btn.Ghost}"
                                                HorizontalAlignment="Right" Margin="0,7,0,0" FontSize="12"
                                                Padding="11,5" Tag="{Binding}" Click="OnUpdateOne" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyText" Style="{StaticResource T.Muted}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed"
                       Text="Nada para atualizar." />
        </Grid>

        <!-- ============ Consola ============ -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Saída do winget" Style="{StaticResource T.H2}" FontSize="13" />
                        <TextBlock x:Name="StatusLine" Style="{StaticResource T.Muted}" Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="ToggleConsole" Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Right"
                            Content="Mostrar" Padding="10,5" FontSize="12" Click="OnToggleConsole" />
                </Grid>
                <TextBox x:Name="Output" Style="{StaticResource Console}" Height="140" Margin="0,12,0,0"
                         Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
