<UserControl x:Class="NexusGuard.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource F.UI}"
             Foreground="{StaticResource B.Text}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel Margin="22,8,22,28" MaxWidth="820" HorizontalAlignment="Left">

            <Border Style="{StaticResource Card}" Background="{StaticResource B.HeroGrad}">
                <StackPanel>
                    <TextBlock Text="Configurações" Style="{StaticResource T.H1}" />
                    <TextBlock Style="{StaticResource T.Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="As preferências ficam em %LocalAppData%\NexusGuard\settings.json e aplicam-se de imediato." />
                </StackPanel>
            </Border>

            <!-- ============ Geral ============ -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Geral" Style="{StaticResource T.H2}" />

                    <Grid Margin="0,16,0,0">
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Text="Iniciar com o Windows" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Abre o NexusGuard minimizado quando o Windows arranca."
                                       Style="{StaticResource T.Muted}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="OptStartup" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="OnStartWithWindows" />
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Text="Manter na bandeja ao fechar" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Fechar a janela deixa a aplicativo em execução em segundo plano."
                                       Style="{StaticResource T.Muted}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="OptTray" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="OnTray" />
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Text="Notificações" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Avisa quando uma tarefa agendada termina."
                                       Style="{StaticResource T.Muted}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="OptNotify" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="OnNotify" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ Segurança ============ -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Segurança" Style="{StaticResource T.H2}" />

                    <Grid Margin="0,16,0,0">
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Text="Ponto de restauração antes de alterações" FontWeight="SemiBold"
                                       FontSize="13" />
                            <TextBlock Text="Criado antes de limpezas e correções do registro."
                                       Style="{StaticResource T.Muted}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="OptRestore" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="OnRestorePoint" />
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Text="Quarentena em vez de apagar" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Desligar isto faz a limpeza apagar os arquivos de forma definitiva."
                                       Style="{StaticResource T.Muted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox x:Name="OptQuarantine" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="OnQuarantine" />
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Text="Pedir confirmação antes de cada alteração" FontWeight="SemiBold"
                                       FontSize="13" />
                            <TextBlock Text="Mostra sempre a pré-visualização antes de mexer em alguma coisa."
                                       Style="{StaticResource T.Muted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox x:Name="OptConfirm" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="OnConfirm" />
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Text="Só drivers assinados (WHQL)" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Drivers sem assinatura da Microsoft não são instalados."
                                       Style="{StaticResource T.Muted}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="OptWhql" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="OnWhql" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Dias em quarentena" Style="{StaticResource T.Label}" />
                            <ComboBox x:Name="QuarantineDays" Style="{StaticResource Cb}" Margin="0,8,0,0"
                                      SelectionChanged="OnQuarantineDays" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Retenção de backups (dias)" Style="{StaticResource T.Label}" />
                            <ComboBox x:Name="BackupDays" Style="{StaticResource Cb}" Margin="0,8,0,0"
                                      SelectionChanged="OnBackupDays" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ Avançado ============ -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Avançado" Style="{StaticResource T.H2}" />

                    <Grid Margin="0,16,0,0">
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Text="Modo simular (dry-run)" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Calcula e regista tudo, mas não altera nada no PC. Útil para mostrar ao cliente o que seria feito."
                                       Style="{StaticResource T.Muted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox x:Name="OptDryRun" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="OnDryRun" />
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Text="Canal beta" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Recebe versões de pré-lançamento quando estiverem disponíveis."
                                       Style="{StaticResource T.Muted}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="OptBeta" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="OnBeta" />
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Text="Enviar estatísticas anônimas" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Versão, módulos usados e falhas. Nunca nomes, arquivos ou endereço IP."
                                       Style="{StaticResource T.Muted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox x:Name="OptTelemetry" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="OnTelemetry" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <WrapPanel>
                        <Button Content="Abrir pasta de dados" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,8"
                                Click="OnOpenData" />
                        <Button Content="Abrir pasta de registros" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,8"
                                Click="OnOpenLogs" />
                        <Button Content="Revisar configuração inicial" Style="{StaticResource Btn.Secondary}"
                                Margin="0,0,8,8" Click="OnRerunOnboarding" />
                    </WrapPanel>

                    <TextBlock x:Name="PathsText" Style="{StaticResource T.Muted}" Margin="2,6,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
