<UserControl x:Class="NexusGuard.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NexusGuard.Views"
             FontFamily="{StaticResource F.UI}"
             Foreground="{StaticResource B.Text}">

    <Grid Margin="22,8,22,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Background="{StaticResource B.HeroGrad}">
            <Grid>
                <StackPanel Margin="0,0,220,0">
                    <TextBlock Text="PROGRAMAS NO ARRANQUE" Style="{StaticResource T.Label}" />
                    <TextBlock x:Name="TotalText" Text="—" Style="{StaticResource T.Metric}" Margin="0,6,0,0" />
                    <TextBlock x:Name="SubText" Style="{StaticResource T.Muted}" Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="Desligar usa a mesma chave do Gerenciador de Tarefas, por isso é sempre reversível." />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ReloadButton" Content="Recarregar" Style="{StaticResource Btn.Secondary}"
                            Click="OnReload" />
                    <Button Content="Abrir Gerenciador de Tarefas" Style="{StaticResource Btn.Ghost}" Margin="0,8,0,0"
                            Click="OnOpenTaskManager" />
                </StackPanel>
            </Grid>
        </Border>

        <views:ErrorState x:Name="State" Grid.Row="1" Margin="0,12,0,0" />

        <Grid Grid.Row="2" Margin="2,18,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="PROGRAMA" Style="{StaticResource T.Label}" />
            <TextBlock Grid.Column="1" Text="ORIGEM" Style="{StaticResource T.Label}" />
            <TextBlock Grid.Column="2" Text="ATIVO" Style="{StaticResource T.Label}" TextAlignment="Right" />
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <ItemsControl x:Name="StartupList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Row}" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Command}" Style="{StaticResource T.Muted}"
                                               FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Command}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LocationText}" Style="{StaticResource T.Dim}" />
                                    <TextBlock Text="{Binding ScopeText}" Style="{StaticResource T.Muted}"
                                               FontSize="11" Margin="0,3,0,0" />
                                </StackPanel>

                                <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Tag="{Binding}" Click="OnToggle" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
