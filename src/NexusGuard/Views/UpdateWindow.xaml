<Window x:Class="NexusGuard.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Modal}"
        WindowStartupLocation="CenterOwner"
        Title="Atualização disponível"
        Width="620" Height="580">

    <Border Style="{StaticResource ModalShell}">
        <Grid Margin="34,30,36,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="ATUALIZAÇÃO DISPONÍVEL" Style="{StaticResource T.Label}" />

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="FromText" Style="{StaticResource T.Mono}" FontSize="17"
                               Foreground="{StaticResource B.TextMuted}" VerticalAlignment="Bottom" />
                    <TextBlock Grid.Column="1" Text="  →  " FontSize="17" VerticalAlignment="Bottom"
                               Foreground="{StaticResource B.TextMuted}" />
                    <TextBlock Grid.Column="2" x:Name="ToText" Style="{StaticResource T.Metric}" />
                </Grid>

                <TextBlock x:Name="SizeText" Style="{StaticResource T.Muted}" Margin="0,6,0,0" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Divider}" Margin="0,18,0,14" />

            <!-- Notas da versão -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="O QUE MUDA" Style="{StaticResource T.Label}" />

                <Border Grid.Row="1" Margin="0,8,0,0" CornerRadius="10" Padding="14,12"
                        Background="{StaticResource B.SurfaceAlt}" BorderThickness="1"
                        BorderBrush="{StaticResource B.Border}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource B.TextDim}" LineHeight="18" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Progresso e aviso -->
            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <ProgressBar x:Name="Progress" Style="{StaticResource Pb}" Minimum="0" Maximum="100"
                             Value="0" Visibility="Collapsed" Margin="0,0,0,8" />

                <TextBlock x:Name="StatusText" Style="{StaticResource T.Muted}" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,0,0,8" />

                <TextBlock Style="{StaticResource T.Muted}" TextWrapping="Wrap" FontSize="11"
                           Text="O ficheiro é transferido do GitHub e conferido contra o hash publicado, o que apanha um download corrompido. Não prova a autenticidade do release: só a assinatura de código o faria, e o NexusGuard ainda não está assinado." />

                <CheckBox x:Name="SkipThis" Style="{StaticResource Chk}" Margin="0,12,0,0"
                          Content="Não avisar outra vez sobre esta versão" />
            </StackPanel>

            <!-- Ações -->
            <Grid Grid.Row="4" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="NotesLink" Grid.Column="0" Content="Ver no GitHub"
                        Style="{StaticResource Btn.Ghost}" Click="OnOpenReleases" />

                <Button x:Name="LaterButton" Grid.Column="2" Content="Agora não"
                        Style="{StaticResource Btn.Secondary}" Margin="0,0,8,0" Click="OnLater" />

                <Button x:Name="InstallButton" Grid.Column="3" Content="Transferir e instalar"
                        Style="{StaticResource Btn.Primary}" Click="OnInstall" />
            </Grid>
        </Grid>
    </Border>
</Window>
