<Window x:Class="NexusGuard.Views.CleanPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Modal}"
        WindowStartupLocation="CenterOwner"
        Title="Confirmar limpeza"
        Width="880" Height="700">

    <Border Style="{StaticResource ModalShell}">
        <Grid Margin="28,24,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ Cabeçalho ============ -->
            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="Confirmar limpeza" FontFamily="{StaticResource F.Display}"
                               FontSize="19" FontWeight="Bold" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource T.Muted}" Margin="0,6,0,0" />
                </StackPanel>

                <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="{StaticResource B.OkSoft}" Padding="11,5">
                    <TextBlock x:Name="QuarantinePill" Text="Quarentena 7 dias" FontSize="11.5"
                               FontWeight="SemiBold" Foreground="{StaticResource B.Ok}" />
                </Border>
            </Grid>

            <!-- ============ Filtros ============ -->
            <WrapPanel x:Name="Chips" Grid.Row="1" Margin="0,18,0,0" />

            <!-- ============ Aviso de proteção ============ -->
            <Border x:Name="ProtectedBanner" Grid.Row="2" Style="{StaticResource Card.Flat}" Margin="0,4,0,0"
                    Background="{StaticResource B.WarnSoft}" BorderBrush="{StaticResource B.Warn}"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon.Small}" Data="{StaticResource I.Shield}"
                          Stroke="{StaticResource B.Warn}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ProtectedText" Margin="11,0,0,0" FontSize="12.5"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource B.Text}" />
                </StackPanel>
            </Border>

            <!-- ============ Lista ============ -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="10,6,12,8">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="SelectAll" Style="{StaticResource Chk}" IsChecked="True"
                                      Click="OnSelectAll" />
                            <TextBlock x:Name="SelectionText" Style="{StaticResource T.Muted}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="TAMANHO" Style="{StaticResource T.Label}" HorizontalAlignment="Right" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="300">
                        <ItemsControl x:Name="FileList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,5,12,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Style="{StaticResource Chk}" IsChecked="{Binding Selected}"
                                                  VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" Margin="12,0,14,0">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource T.Mono}"
                                                       FontSize="10.5" Foreground="{StaticResource B.TextMuted}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                       ToolTip="{Binding Path}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                   Style="{StaticResource T.Mono}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource B.TextDim}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ============ Ponto de restauração ============ -->
            <CheckBox x:Name="MakeRestorePoint" Grid.Row="4" Style="{StaticResource Chk}" Margin="2,16,0,0"
                      Content="Criar ponto de restauração antes" IsChecked="True" />

            <!-- ============ Rodapé ============ -->
            <Grid Grid.Row="5" Margin="0,18,0,0">
                <TextBlock x:Name="FooterNote" Style="{StaticResource T.Muted}" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="380" HorizontalAlignment="Left" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource Btn.Ghost}" Click="OnCancel" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource Btn.Primary}" Margin="9,0,0,0"
                            Padding="20,11" Click="OnConfirm" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
