<UserControl x:Class="NexusGuard.Views.ErrorState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource F.UI}"
             Foreground="{StaticResource B.Text}">

    <Border Style="{StaticResource Card}" Padding="24" CornerRadius="14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="IconBox" Width="38" Height="38" CornerRadius="10" VerticalAlignment="Top"
                    Background="{StaticResource B.WarnSoft}">
                <Path x:Name="IconPath" Data="{StaticResource I.Alert}" Stretch="Uniform" Margin="9"
                      Stroke="{StaticResource B.Warn}" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" Fill="Transparent" />
            </Border>

            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock x:Name="ModuleText" Style="{StaticResource T.Label}" />
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="BodyText" Style="{StaticResource T.Dim}" FontSize="12.5" Margin="0,7,0,0"
                           TextWrapping="Wrap" />

                <StackPanel x:Name="Actions" Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="PrimaryButton" Style="{StaticResource Btn.Primary}" Click="OnPrimary"
                            Visibility="Collapsed" />
                    <Button x:Name="SecondaryButton" Style="{StaticResource Btn.Ghost}" Margin="8,0,0,0"
                            Click="OnSecondary" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
