<UserControl x:Class="NexusGuard.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NexusGuard.Views"
             FontFamily="{StaticResource F.UI}"
             Foreground="{StaticResource B.Text}">

    <Grid Margin="22,8,22,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.6*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Esquerda: categorias ================= -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Background="{StaticResource B.HeroGrad}">
                <Grid>
                    <StackPanel Margin="0,0,300,0">
                        <TextBlock Text="ESPAÇO RECUPERÁVEL" Style="{StaticResource T.Label}" />
                        <TextBlock x:Name="TotalText" Text="—" Style="{StaticResource T.Metric}" Margin="0,6,0,0" />
                        <TextBlock x:Name="TotalDetail" Style="{StaticResource T.Muted}" Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Text="Faça uma análise para ver o que pode ser removido." />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button x:Name="SelectAllButton" Content="Só os seguros" Style="{StaticResource Btn.Ghost}"
                                Click="OnSelectSafe" />
                        <Button x:Name="ScanButton" Content="Analisar" Style="{StaticResource Btn.Secondary}"
                                Margin="8,0,0,0" Click="OnScan" />
                        <Button x:Name="CleanButton" Content="Limpar" Style="{StaticResource Btn.Primary}"
                                Margin="8,0,0,0" Click="OnClean" />
                        <Button x:Name="CancelButton" Content="Parar" Style="{StaticResource Btn.Danger}"
                                Margin="8,0,0,0" Click="OnCancel" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>

            <views:ErrorState x:Name="State" Grid.Row="1" Margin="0,12,0,0" />

            <ProgressBar x:Name="Progress" Grid.Row="2" Style="{StaticResource Pb}" Margin="0,10,0,0"
                         Visibility="Collapsed" IsIndeterminate="True" Height="4" />

            <ScrollViewer Grid.Row="3" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>
                    <ItemsControl x:Name="TargetList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Row}" Padding="16,13">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Style="{StaticResource Chk}" IsChecked="{Binding Selected}"
                                                  VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" Margin="14,0,16,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           FontSize="13.5" />
                                                <Border Style="{StaticResource Pill}" Margin="10,0,0,0" Padding="7,2"
                                                        Background="{StaticResource B.SurfaceAlt}">
                                                    <TextBlock Text="{Binding RiskText}" FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding Risk, Converter={StaticResource RiskToBrush}}" />
                                                </Border>
                                                <Border Style="{StaticResource Pill}" Margin="6,0,0,0" Padding="7,2"
                                                        Background="{StaticResource B.SurfaceAlt}"
                                                        Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="admin" FontSize="10.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource B.TextDim}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource T.Muted}"
                                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="100"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" FontSize="14"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding DetailText}" Style="{StaticResource T.Muted}"
                                                       FontSize="11" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="3" Text="{Binding Status}"
                                                   Style="{StaticResource T.Muted}" VerticalAlignment="Center"
                                                   Margin="18,0,2,0" MinWidth="140" TextAlignment="Right"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Manutenção avançada do Windows" Style="{StaticResource T.H2}" />
                            <TextBlock Style="{StaticResource T.Muted}" Margin="0,6,0,14" TextWrapping="Wrap"
                                       Text="Executadas pelas ferramentas do próprio Windows; podem demorar vários minutos." />
                            <WrapPanel>
                                <Button x:Name="DismButton" Content="Compactar componentes (DISM)"
                                        Style="{StaticResource Btn.Secondary}" Margin="0,0,8,8"
                                        Click="OnComponentCleanup" />
                                <Button Content="Limpeza de Disco do Windows" Style="{StaticResource Btn.Ghost}"
                                        Margin="0,0,8,8" Click="OnOpenCleanmgr" />
                                <Button Content="Definições de Armazenamento" Style="{StaticResource Btn.Ghost}"
                                        Margin="0,0,8,8" Click="OnOpenStorage" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Detalhe da operação" Style="{StaticResource T.H2}" FontSize="13" />
                            <TextBlock x:Name="StatusLine" Style="{StaticResource T.Muted}" Margin="12,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="ToggleConsole" Content="Mostrar" Style="{StaticResource Btn.Ghost}"
                                HorizontalAlignment="Right" Padding="10,5" FontSize="12" Click="OnToggleConsole" />
                    </Grid>
                    <TextBox x:Name="Output" Style="{StaticResource Console}" Height="120" Margin="0,12,0,0"
                             Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= Direita: quarentena ================= -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Grid>
                        <TextBlock Text="Quarentena" Style="{StaticResource T.H2}" />
                        <Button x:Name="EmptyAllButton" Content="Esvaziar tudo" Style="{StaticResource Btn.Ghost}"
                                HorizontalAlignment="Right" Padding="10,5" FontSize="12"
                                Click="OnEmptyQuarantine" />
                    </Grid>
                    <TextBlock x:Name="QuarantineSummary" Style="{StaticResource T.Muted}" Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <TextBlock x:Name="QuarantineEmpty" Style="{StaticResource T.Muted}" TextWrapping="Wrap"
                                   Text="Nada em quarentena. Os ficheiros removidos pela limpeza aparecem aqui e podem ser repostos." />

                        <ItemsControl x:Name="BatchList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row}" Padding="14,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource T.Muted}"
                                                       Margin="0,4,0,0" />

                                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                <TextBlock Text="{Binding WhenText}" Style="{StaticResource T.Muted}"
                                                           FontSize="11" VerticalAlignment="Center" />
                                                <Border Margin="8,0,0,0" Padding="7,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource B.SurfaceAlt}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Expiring}" Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="{StaticResource B.WarnSoft}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding ExpiryText}" FontSize="10.5">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock"
                                                                   BasedOn="{StaticResource T.Base}">
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource B.TextMuted}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Expiring}"
                                                                                 Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="{StaticResource B.Warn}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                                <Button Content="Restaurar" Style="{StaticResource Btn.Ghost}"
                                                        FontSize="12" Padding="11,5" Tag="{Binding}"
                                                        Foreground="{StaticResource B.Accent2}"
                                                        Click="OnRestoreBatch" />
                                                <Button Content="Apagar" Style="{StaticResource Btn.Danger}"
                                                        Margin="7,0,0,0" FontSize="12" Padding="11,5"
                                                        Tag="{Binding}" Click="OnDeleteBatch" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Border Style="{StaticResource Divider}" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource T.Muted}" TextWrapping="Wrap"
                               Text="Os ficheiros ficam guardados em ProgramData\NexusGuard\Quarantine, sem permissão de execução." />
                    <Button Content="Abrir pasta da quarentena" Style="{StaticResource Btn.Ghost}"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnOpenQuarantine" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
