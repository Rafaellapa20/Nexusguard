<UserControl x:Class="NexusGuard.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource F.UI}"
             Foreground="{StaticResource B.Text}">

    <Grid Margin="22,8,22,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Background="{StaticResource B.HeroGrad}">
            <Grid>
                <StackPanel Margin="0,0,280,0">
                    <TextBlock Text="Hardware" Style="{StaticResource T.H1}" />
                    <TextBlock x:Name="SummaryText" Style="{StaticResource T.Muted}" Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Text="Inventário e saúde dos componentes, lidos do WMI do Windows." />
                    <TextBlock x:Name="StressText" Style="{StaticResource T.Dim}" Margin="0,10,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button x:Name="ScanButton" Content="Analisar" Style="{StaticResource Btn.Secondary}"
                            Click="OnScan" />
                    <Button x:Name="StressButton" Content="Teste de estresse" Style="{StaticResource Btn.Ghost}"
                            Margin="8,0,0,0" Click="OnStress" />
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar x:Name="Progress" Grid.Row="1" Style="{StaticResource Pb}" Margin="0,10,0,0"
                     Visibility="Collapsed" IsIndeterminate="True" Height="4" />

        <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <ItemsControl x:Name="ComponentList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="372" Margin="0,0,12,12">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Margin="0,0,86,0">
                                        <TextBlock Text="{Binding Kind}" Style="{StaticResource T.Label}" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"
                                                   Margin="0,5,0,0" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Border Padding="9,3" HorizontalAlignment="Right"
                                            VerticalAlignment="Top">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                <Setter Property="Background" Value="{StaticResource B.SurfaceAlt}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource B.OkSoft}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource B.WarnSoft}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding LevelText}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
                                                    <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource B.Ok}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource B.Warn}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,14,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource T.Muted}" />
                                                <TextBlock Text="{Binding Value}" HorizontalAlignment="Right"
                                                           FontSize="12.5" FontFamily="{StaticResource F.Mono}"
                                                           Foreground="{StaticResource B.Text}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding Note}" Style="{StaticResource T.Muted}" Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Note, Converter={StaticResource TextToVis}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
