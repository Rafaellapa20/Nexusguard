<UserControl x:Class="NexusGuard.Views.RegistryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NexusGuard.Views"
             FontFamily="{StaticResource F.UI}"
             Foreground="{StaticResource B.Text}">

    <Grid Margin="22,8,22,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Background="{StaticResource B.HeroGrad}">
            <Grid>
                <StackPanel Margin="0,0,260,0">
                    <TextBlock Text="ENTRADAS INVÁLIDAS" Style="{StaticResource T.Label}" />
                    <TextBlock x:Name="TotalText" Text="—" Style="{StaticResource T.Metric}" Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource T.Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Só entradas que apontam para coisas que já não existem. Nada de «limpeza agressiva» — e é sempre exportado um .reg antes de remover." />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button x:Name="ScanButton" Content="Analisar" Style="{StaticResource Btn.Secondary}"
                            Click="OnScan" />
                    <Button x:Name="FixButton" Content="Corrigir" Style="{StaticResource Btn.Primary}"
                            Margin="8,0,0,0" Click="OnFix" />
                </StackPanel>
            </Grid>
        </Border>

        <views:ErrorState x:Name="State" Grid.Row="1" Margin="0,12,0,0" />

        <ProgressBar x:Name="Progress" Grid.Row="2" Style="{StaticResource Pb}" Margin="0,10,0,0"
                     Visibility="Collapsed" IsIndeterminate="True" Height="4" />

        <ScrollViewer Grid.Row="3" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <ItemsControl x:Name="CategoryList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Row}" Padding="16,13">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Style="{StaticResource Chk}" IsChecked="{Binding Selected}"
                                          VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Margin="14,0,16,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource T.Muted}"
                                               Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding CountText}" FontWeight="SemiBold"
                                           FontSize="15" VerticalAlignment="Center" MinWidth="70"
                                           TextAlignment="Right" FontFamily="{StaticResource F.Mono}" />

                                <TextBlock Grid.Column="3" Text="{Binding Status}" Style="{StaticResource T.Muted}"
                                           VerticalAlignment="Center" Margin="18,0,2,0" MinWidth="130"
                                           TextAlignment="Right" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Detalhe" Style="{StaticResource T.H2}" FontSize="13" />
                        <TextBlock x:Name="StatusLine" Style="{StaticResource T.Muted}" Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="ToggleConsole" Content="Mostrar" Style="{StaticResource Btn.Ghost}"
                            HorizontalAlignment="Right" Padding="10,5" FontSize="12" Click="OnToggleConsole" />
                </Grid>
                <TextBox x:Name="Output" Style="{StaticResource Console}" Height="120" Margin="0,12,0,0"
                         Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
