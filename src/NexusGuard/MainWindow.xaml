<Window x:Class="NexusGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NexusGuard — Manutenção do Windows"
        Width="1340" Height="860" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource B.Bg}"
        Foreground="{StaticResource B.Text}"
        FontFamily="{StaticResource F.UI}"
        WindowStyle="None"
        Icon="Assets/app.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource B.Border}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================== Barra lateral ==================== -->
            <Border Grid.Column="0" Background="{StaticResource B.SidebarGrad}">
                <Border BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Marca -->
                        <StackPanel Grid.Row="0" Margin="18,20,18,14" Orientation="Horizontal">
                            <Image Source="Assets/brand/icon-128.png" Width="38" Height="38"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource F.Display}" FontSize="18" FontWeight="SemiBold">
                                    <Run Text="Nexus" Foreground="{StaticResource B.Text}" />
                                    <Run Text="Guard" Foreground="{StaticResource B.Accent2}" />
                                </TextBlock>
                                <TextBlock Text="Manutenção do Windows" Style="{StaticResource T.Muted}"
                                           FontSize="10.5" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Navegação (construída em código) -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <StackPanel x:Name="NavHost" Margin="10,0,10,8" />
                        </ScrollViewer>

                        <!-- Rodapé -->
                        <StackPanel Grid.Row="2" Margin="16,8,16,16">
                            <Border Style="{StaticResource Card.Flat}" Padding="14,12">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="SAÚDE DO SISTEMA" Style="{StaticResource T.Label}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="ScoreValue" Text="—" HorizontalAlignment="Right"
                                                   FontFamily="{StaticResource F.Mono}" FontSize="26"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                    <Border Height="4" CornerRadius="2" Margin="0,10,0,0"
                                            Background="{StaticResource B.SurfaceAlt}">
                                        <Border x:Name="ScoreBar" HorizontalAlignment="Left" Width="0"
                                                CornerRadius="2" Background="{StaticResource B.Ok}" />
                                    </Border>
                                    <TextBlock x:Name="ScoreLabel" Style="{StaticResource T.Muted}" Margin="0,8,0,0"
                                               TextWrapping="Wrap" Text="Analise o PC para calcular." />
                                </StackPanel>
                            </Border>

                            <Border x:Name="AdminBanner" Style="{StaticResource Card.Flat}" Padding="12"
                                    Margin="0,10,0,0" Background="{StaticResource B.WarnSoft}"
                                    BorderBrush="{StaticResource B.Warn}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Icon.Small}" Data="{StaticResource I.Admin}"
                                              Stroke="{StaticResource B.Warn}" />
                                        <TextBlock Text="Sem privilégios" Margin="8,0,0,0" FontWeight="SemiBold"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{StaticResource B.Warn}" />
                                    </StackPanel>
                                    <TextBlock Text="Algumas ações do sistema precisam de administrador."
                                               Style="{StaticResource T.Muted}" TextWrapping="Wrap"
                                               Margin="0,7,0,9" />
                                    <Button Style="{StaticResource Btn.Secondary}" FontSize="12" Padding="10,8"
                                            Click="OnElevate">
                                        <TextBlock Text="Reiniciar como administrador" TextWrapping="Wrap"
                                                   TextAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border x:Name="AdminOk" Style="{StaticResource Pill}" Visibility="Collapsed"
                                    Background="{StaticResource B.OkSoft}" HorizontalAlignment="Left"
                                    Padding="10,5" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon.Small}" Data="{StaticResource I.Check}"
                                          Stroke="{StaticResource B.Ok}" Width="13" Height="13" />
                                    <TextBlock Text="Em execução como administrador" Margin="7,0,0,0" FontSize="11.5"
                                               Foreground="{StaticResource B.Ok}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="VersionText" Style="{StaticResource T.Muted}" FontSize="10.5"
                                       Margin="2,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- ==================== Área principal ==================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="{StaticResource B.Bg}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="Visão geral" Style="{StaticResource T.H2}" FontSize="14" />
                        <Border Style="{StaticResource Pill}" Margin="14,0,0,0" Padding="9,3"
                                Background="{StaticResource B.SurfaceAlt}">
                            <TextBlock x:Name="MachineText" Style="{StaticResource T.Muted}" FontSize="11" />
                        </Border>
                        <Border x:Name="DryRunPill" Style="{StaticResource Pill}" Margin="8,0,0,0" Padding="9,3"
                                Background="{StaticResource B.WarnSoft}" Visibility="Collapsed">
                            <TextBlock Text="modo simular" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource B.Warn}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource Btn.Chrome}" Click="OnMinimize" ToolTip="Minimizar">
                            <Path Data="M0,0 H11" Stroke="{StaticResource B.TextDim}" StrokeThickness="1.2" />
                        </Button>
                        <Button x:Name="MaxButton" Style="{StaticResource Btn.Chrome}" Click="OnMaximize"
                                ToolTip="Maximizar">
                            <Path x:Name="MaxIcon" Data="M0.5,0.5 H10.5 V10.5 H0.5 Z"
                                  Stroke="{StaticResource B.TextDim}" StrokeThickness="1.2" Fill="Transparent" />
                        </Button>
                        <Button Style="{StaticResource Btn.Close}" Click="OnClose" ToolTip="Fechar">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource B.TextDim}"
                                  StrokeThickness="1.2" />
                        </Button>
                    </StackPanel>
                </Grid>

                <ContentControl x:Name="Host" Grid.Row="1" />
            </Grid>
        </Grid>
    </Border>
</Window>
